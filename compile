#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s [--language eng|rus|all]\n' "$0"
    printf 'Build both CV PDFs by default. Requires XeLaTeX.\n'
}

language=all
while (($#)); do
    case "$1" in
        --language)
            if (($# < 2)); then
                printf 'Error: --language requires eng, rus, or all.\n' >&2
                exit 2
            fi
            language=$2
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Error: unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$language" in
    eng|rus) languages=("$language") ;;
    all) languages=(eng rus) ;;
    *)
        printf 'Error: invalid language: %s (choose eng, rus, or all).\n' "$language" >&2
        exit 2
        ;;
esac

if ! command -v xelatex >/dev/null 2>&1; then
    printf 'Error: xelatex is not installed. See README.md for dependencies.\n' >&2
    exit 1
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "$project_dir"

for language in "${languages[@]}"; do
    source_file="cv-$language.tex"
    output_dir="build/$language"
    pdf="build/RomanDugaev_CV_$language.pdf"

    if [[ ! -f "$source_file" ]]; then
        printf 'Error: missing source file: %s\n' "$source_file" >&2
        exit 1
    fi

    mkdir -p -- "$output_dir"
    for pass in 1 2; do
        printf 'Building %s (pass %s/2)\n' "$language" "$pass"
        xelatex -no-shell-escape -interaction=nonstopmode -halt-on-error \
            -file-line-error -output-directory="$output_dir" "$source_file" </dev/null
    done
    cp -- "$output_dir/cv-$language.pdf" "$pdf"
    printf 'Built %s\n' "$project_dir/$pdf"
done
