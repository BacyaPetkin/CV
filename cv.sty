\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}[2026/10/22 Shared CV layout]

% A compact, single-column layout in the spirit of the original Russell CV.
\RequirePackage[a4paper,margin=17mm,footskip=9mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setmainfont{Noto Sans}
\newfontfamily\cyrillicfont{Noto Sans}
\RequirePackage{xcolor}
\definecolor{ink}{HTML}{26313B}
\definecolor{accent}{HTML}{28576B}
\definecolor{muted}{HTML}{596773}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[unicode,hidelinks]{hyperref}
\RequirePackage{bookmark}

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\setlist[itemize]{leftmargin=1.3em,itemsep=3pt,topsep=4pt,parsep=0pt,before=\raggedright}
\titleformat{\section}{\large\bfseries\color{accent}}{}{0pt}{}[\titlerule]
\titlespacing*{\section}{0pt}{12pt}{6pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{muted}\cvname}
\fancyfoot[R]{\footnotesize\color{muted}\thepage}
\AtBeginDocument{\color{ink}\raggedright}

\newcommand{\cvheader}[2]{%
  \def\cvname{#1}%
  \hypersetup{pdfauthor={#1},pdftitle={#1 — CV},pdfsubject={#2}}%
  {\fontsize{28}{34}\selectfont\bfseries #1\par}%
  {\large\color{accent}#2\par}%
  \vspace{3pt}%
  {\small
    \href{mailto:dugaevr@gmail.com}{dugaevr@gmail.com}\quad
    \href{https://t.me/BacyaPetkin}{Telegram: @BacyaPetkin}\quad
    \href{https://github.com/BacyaPetkin}{github.com/BacyaPetkin}\par}%
}

\newcommand{\cventry}[3]{%
  \Needspace{5\baselineskip}%
  \vspace{5pt}%
  {\bfseries #1}\hfill{\small\color{muted}#2}\par\nopagebreak
  {\small\color{muted}#3\par}\nopagebreak
}

\newcommand{\cvskill}[2]{\textbf{#1}\enspace #2\par}
